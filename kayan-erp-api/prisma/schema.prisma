// ==========================================
// 1. MES & BOM MODULE
// ==========================================

model bom_headers {
  id                 BigInt        @id @default(autoincrement())
  company_id         BigInt
  item_id            BigInt
  bom_code           String        @db.VarChar(50)
  bom_name           String        @db.VarChar(200)
  version            String        @default("1.0") @db.VarChar(20)
  is_active          Boolean       @default(true)
  standard_batch_qty Decimal       @db.Decimal(18, 3)
  batch_unit         String        @db.VarChar(50)
  total_cost         Decimal?      @default(0) @db.Decimal(18, 4)
  notes              String?
  created_at         DateTime      @default(now()) @db.Timestamptz(6)
  updated_at         DateTime      @default(now()) @db.Timestamptz(6)
  bom_items          bom_items[]
  work_orders        work_orders[]

  @@unique([company_id, bom_code, version], map: "ux_bom_headers_code_version")
  @@index([company_id], map: "idx_bom_headers_company")
  @@index([item_id], map: "idx_bom_headers_item")
}

model bom_items {
  id                 BigInt      @id @default(autoincrement())
  bom_header_id      BigInt
  component_item_id  BigInt
  quantity           Decimal     @db.Decimal(18, 4)
  unit               String      @db.VarChar(50)
  scrap_factor_pct   Decimal     @default(0) @db.Decimal(6, 2)
  item_type          String      @default("RAW_MATERIAL") @db.VarChar(30)
  parent_bom_item_id BigInt?
  line_number        Int         @default(1)
  notes              String?
  created_at         DateTime    @default(now()) @db.Timestamptz(6)
  bom_headers        bom_headers @relation(fields: [bom_header_id], references: [id], onDelete: Cascade)
  parent_item        bom_items?  @relation("bom_item_hierarchy", fields: [parent_bom_item_id], references: [id])
  child_items        bom_items[] @relation("bom_item_hierarchy")

  @@index([bom_header_id], map: "idx_bom_items_header")
  @@index([component_item_id], map: "idx_bom_items_component")
}

model work_orders {
  id                 BigInt              @id @default(autoincrement())
  company_id         BigInt
  work_order_number  String              @db.VarChar(50)
  batch_id           String              @db.VarChar(50)
  bom_header_id      BigInt?
  item_id            BigInt
  warehouse_id       BigInt
  target_quantity    Decimal             @db.Decimal(18, 3)
  produced_quantity  Decimal             @default(0) @db.Decimal(18, 3)
  scrap_quantity     Decimal             @default(0) @db.Decimal(18, 3)
  status             String              @default("PLANNED") @db.VarChar(30)
  priority           String              @default("MEDIUM") @db.VarChar(20)
  start_date         DateTime?           @db.Timestamptz(6)
  end_date           DateTime?           @db.Timestamptz(6)
  notes              String?
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime            @default(now()) @db.Timestamptz(6)
  bom_headers        bom_headers?        @relation(fields: [bom_header_id], references: [id])
  routing_steps      routing_steps[]
  work_order_scraps  work_order_scraps[]

  @@unique([company_id, work_order_number], map: "ux_work_orders_number")
  @@index([company_id], map: "idx_work_orders_company")
  @@index([batch_id], map: "idx_work_orders_batch")
  @@index([status], map: "idx_work_orders_status")
}

model routing_steps {
  id                BigInt              @id @default(autoincrement())
  work_order_id     BigInt
  step_number       Int
  step_name         String              @db.VarChar(100)
  status            String              @default("PENDING") @db.VarChar(30)
  planned_minutes   Int                 @default(60)
  actual_minutes    Int?
  input_quantity    Decimal?            @db.Decimal(18, 3)
  output_quantity   Decimal?            @db.Decimal(18, 3)
  operator_name     String?             @db.VarChar(100)
  machine_code      String?             @db.VarChar(50)
  started_at        DateTime?           @db.Timestamptz(6)
  completed_at      DateTime?           @db.Timestamptz(6)
  notes             String?
  work_orders       work_orders         @relation(fields: [work_order_id], references: [id], onDelete: Cascade)
  work_order_scraps work_order_scraps[]

  @@unique([work_order_id, step_number], map: "ux_routing_steps_order_step")
  @@index([work_order_id], map: "idx_routing_steps_order")
}

model work_order_scraps {
  id                    BigInt         @id @default(autoincrement())
  work_order_id         BigInt
  routing_step_id       BigInt?
  item_id               BigInt
  quantity              Decimal        @db.Decimal(18, 3)
  scrap_reason_category String         @db.VarChar(30)
  scrap_reason_detail   String         @db.VarChar(250)
  logged_by             String?        @db.VarChar(100)
  created_at            DateTime       @default(now()) @db.Timestamptz(6)
  work_orders           work_orders    @relation(fields: [work_order_id], references: [id], onDelete: Cascade)
  routing_steps         routing_steps? @relation(fields: [routing_step_id], references: [id])

  @@index([work_order_id], map: "idx_work_order_scraps_order")
}

model shift_logs {
  id              BigInt   @id @default(autoincrement())
