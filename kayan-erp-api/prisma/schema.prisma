  material_requisitions_material_requisitions_to_warehouse_idTowarehouses                material_requisitions[]      @relation("material_requisitions_to_warehouse_idTowarehouses")
  production_orders                                                                      production_orders[]
  purchase_orders                                                                        purchase_orders[]
  quality_inspections                                                                    quality_inspections[]
  sales_orders                                                                           sales_orders[]
  stock_balances                                                                         stock_balances[]
  stock_movements                                                                        stock_movements[]
  stock_transfers_stock_transfers_from_warehouse_idTowarehouses                          stock_transfers[]            @relation("stock_transfers_from_warehouse_idTowarehouses")
  stock_transfers_stock_transfers_to_warehouse_idTowarehouses                            stock_transfers[]            @relation("stock_transfers_to_warehouse_idTowarehouses")
  branches                                                                               branches?                    @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_warehouses_branches_branch_id")
  companies                                                                              companies                    @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_warehouses_companies_company_id")
  warehouses                                                                             warehouses?                  @relation("warehousesTowarehouses", fields: [parent_warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_warehouses                                                                       warehouses[]                 @relation("warehousesTowarehouses")
  waste_records                                                                          waste_records[]

  @@index([branch_id], map: "IX_warehouses_branch_id")
  @@index([company_id], map: "IX_warehouses_company_id")
}

model waste_records {
  id                      BigInt                   @id @default(autoincrement())
  company_id              BigInt
  item_id                 BigInt
  warehouse_id            BigInt?
  production_order_id     BigInt?
  production_stage_id     BigInt?
  quantity                Decimal                  @db.Decimal(18, 6)
  waste_reason            String                   @db.VarChar(150)
  waste_date              DateTime                 @default(now()) @db.Timestamptz(6)
  notes                   String?
  created_at              DateTime                 @default(now()) @db.Timestamptz(6)
  created_by              BigInt?
  CreatedByNavigationId   BigInt?
  users                   users?                   @relation(fields: [CreatedByNavigationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_waste_records_users_CreatedByNavigationId")
  companies               companies                @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "waste_company_fk")
  items                   items                    @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "waste_item_fk")
  production_orders       production_orders?       @relation(fields: [production_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "waste_production_order_fk")
  production_order_stages production_order_stages? @relation(fields: [production_stage_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "waste_production_stage_fk")
  warehouses              warehouses?              @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([CreatedByNavigationId], map: "IX_waste_records_CreatedByNavigationId")
  @@index([company_id], map: "IX_waste_records_company_id")
  @@index([item_id], map: "IX_waste_records_item_id")
  @@index([production_stage_id], map: "IX_waste_records_production_stage_id")
  @@index([warehouse_id], map: "IX_waste_records_warehouse_id")
  @@index([production_order_id], map: "idx_waste_production")
}
